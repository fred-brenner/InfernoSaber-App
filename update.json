{
  "run": [
    {
      "method": "shell.run",
      "params": {
        "path": "infernosaber",
        "conda": "conda_env",
        "message": [
          "git fetch origin main_app",
          "git checkout -- .",
          "git pull --ff-only origin main_app",
          "conda install -y conda-forge::ffmpeg=*=*gpl*",
          "uv pip install --isolated -r requirements.txt",
          "uv pip install --isolated onnxruntime==1.20.1 tf2onnx==1.16.1 onnx==1.17.0",
          "python -c \"import onnxruntime, tf2onnx; print('ONNX dependencies verified')\""
        ]
      }
    },
    {
      "method": "hf.download",
      "params": {
        "_": [
          "BierHerr/InfernoSaber"
        ],
        "revision": "v2_expert",
        "local-dir": "Data/model/v2_expert"
      }
    },
    {
      "method": "hf.download",
      "params": {
        "_": [
          "BierHerr/InfernoSaber"
        ],
        "revision": "v2_expert_noterepair-c50",
        "local-dir": "Data/model/v2_expert_noterepair-c50"
      }
    },
    {
      "method": "input",
      "params": {
        "title": "Update Success",
        "description": "The app has been updated successfully!"
      }
    },
    {
      "method": "web.open",
      "params": {
        "uri": "/?selected=infernosaber"
      }
    }
  ]
}