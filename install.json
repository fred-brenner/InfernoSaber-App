{
  "requires": {
    "bundle": "ai"
  },
  "run": [
    {
      "when": "{{!exists('infernosaber')}}",
      "method": "shell.run",
      "params": {
        "message": "git clone -b main_app https://github.com/fred-brenner/InfernoSaber---BeatSaber-Automapper.git infernosaber"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "path": "infernosaber",
        "conda": {
          "path": "conda_env",
          "python": "python=3.10"
        },
        "env": {
          "CFLAGS": "{{platform === 'darwin' ? '-Wno-incompatible-function-pointer-types' : ''}}"
        },
        "message": [
          "{{platform === 'darwin' ? 'uv pip install numpy==1.26.4 setuptools wheel && uv pip install --no-build-isolation aubio==0.4.9 pydub' : 'conda install -c conda-forge -y aubio pydub'}}",
          "conda install -y conda-forge::ffmpeg=*=*gpl*",
          "uv pip install --isolated -r requirements.txt",
          "python -c \"import aubio, pydub, tensorflow, gradio; from tkinter import Tk; print('Dependencies verified')\"",
          "ffmpeg -version"
        ]
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "{{platform === 'win32' ? 'type nul > install_successfull.txt' : 'touch install_successfull.txt'}}"
      }
    },
    {
      "method": "notify",
      "params": {
        "html": "Installation finished! Click Launch to start InfernoSaber."
      }
    }
  ]
}
